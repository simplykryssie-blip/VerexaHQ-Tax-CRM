# VerexaHQ Tax CRM — environment variables
#
# This project connects EXCLUSIVELY to the "VerexaHQ Tax Office" Supabase project
# (ref: aewqbffscdrziiwfomyf). Do NOT point these variables at the separate
# VerexaHQ CRM Supabase project (ref: euxfopzgdmlmgcmmjvic) — that is a different
# application's database and must never be used here.

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://aewqbffscdrziiwfomyf.supabase.co

# Supabase publishable / anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Never import this in a Client Component or any code bundled to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this application (used for auth redirect links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
